{
  "profile_id": "arduplane_mavlog_json",
  "version": "1",
  "family": "fixed_wing",
  "source_role": "fc",
  "format": "pymavlink_dataflash_jsonl",
  "extensions": [
    "jsonl"
  ],
  "default_clock_basis": "boot_relative",
  "channels": [
    "onboard",
    "event",
    "gps_ekf"
  ],
  "fields": {
    "time": "TimeUS",
    "gps": [
      "GPS.Lat",
      "GPS.Lng",
      "GPS.Alt"
    ]
  },
  "units": {
    "TimeUS": "us",
    "GPS.Lat": "deg",
    "GPS.Lng": "deg",
    "GPS.Alt": "m",
    "PARM.Name": "reported_parameter_identifier",
    "PARM.Value": "reported_parameter_value_unit_not_inferred",
    "PARM.Default": "reported_board_config_default_unit_not_inferred"
  }
}
